---
interface Props {
  mode: 'poster' | 'logo' | 'tile';
  src: string;
  alt: string;
  logo?: string;
  logoAlt?: string;
  tile: string;
  quiet: boolean;
  size?: 'page' | 'card';
  frameClass?: string;
  icon?: string;
}

const {
  mode,
  src,
  alt,
  logo = '',
  logoAlt = '',
  tile,
  quiet,
  size = 'page',
  frameClass = '',
  icon = '',
} = Astro.props;
---

<div
  class:list={['frame relative aspect-square overflow-hidden', frameClass]}
  data-frame
  data-mode={mode}
  data-size={size}
  data-quiet={quiet ? '' : undefined}
  data-logo={logo || undefined}
  data-logo-alt={logoAlt || undefined}
  data-icon={icon ? '' : undefined}
>
  {src && (
    <img class="frame__img" src={src} alt={alt} data-poster referrerpolicy="no-referrer" />
  )}
  {icon && <span class="frame__icon" set:html={icon} aria-hidden="true" />}
  <p class="frame__tile" aria-hidden="true">{tile}</p>
</div>

<style>
  .frame { background: #0e451c; }
  .frame[data-quiet] { background: #2a2725; }
  .frame__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    margin: 0;
    object-fit: contain;
    object-position: center;
  }
  .frame__tile {
    display: none;
    position: absolute;
    inset: 0;
    margin: 0;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    text-align: center;
    text-wrap: balance;
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.75rem;
    line-height: 1.15;
    color: #f9edd2;
  }
  .frame__icon {
    display: none;
    position: absolute;
    inset: 0;
    align-items: center;
    justify-content: center;
    color: #f9edd2;
  }
  .frame__icon :global(svg) {
    width: min(42%, 7.5rem);
    height: min(42%, 7.5rem);
  }
  .frame[data-mode="tile"][data-icon] .frame__icon { display: flex; }
  .frame[data-mode="tile"][data-icon] .frame__tile { display: none; }
  .frame[data-mode="tile"] .frame__tile { display: flex; }
  .frame[data-quiet] .frame__icon { color: #cfc6bb; }
  .frame[data-quiet] .frame__tile { color: #cfc6bb; }
  .frame[data-size="card"] .frame__tile {
    padding: 0.45rem;
    font-size: 0.95rem;
  }
</style>
