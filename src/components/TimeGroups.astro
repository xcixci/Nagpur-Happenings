---
import EventCard from './EventCard.astro';
import { groupByStart, timeHeading } from '../lib/calendar';
import type { EventRecord, OrganiserRecord, VenueRecord } from '../lib/sheet-map';

interface Props {
  events: EventRecord[];
  organisers: OrganiserRecord[];
  venues: VenueRecord[];
  cityName: string;
  domain: string;
  timeZone: string;
  showDate?: boolean;
}

const { events, organisers, venues, cityName, domain, timeZone, showDate = true } = Astro.props;
const groups = groupByStart(events);
---

{groups.map((group) => (
  <section data-time-group>
    <h2 class="time-heading" data-time-heading data-time={group.time}>{timeHeading(group)}</h2>
    <ul class="event-list">
      {group.events.map((event) => (
        <li>
          <EventCard event={event} organisers={organisers} venues={venues} cityName={cityName} domain={domain} timeZone={timeZone} showDate={showDate} />
        </li>
      ))}
    </ul>
  </section>
))}
