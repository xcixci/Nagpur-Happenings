---
import EventMedia from './EventMedia.astro';
import { categoryIcon } from '../lib/category-icons';
import { organiserTypeLabel, servesAlcohol, taglineOf } from '../lib/directory';
import { localLogo } from '../lib/logos';
import type { OrganiserRecord } from '../lib/sheet-map';

interface Props {
  organiser: OrganiserRecord;
}

const { organiser } = Astro.props;
const logo = localLogo(organiser.id);
const tagline = taglineOf(organiser);
const type = organiserTypeLabel(organiser.type);
const alcohol = servesAlcohol(organiser);
---

<a class="org-card" href={`/organisers/${organiser.slug}/`} data-filter-item data-category={organiser.category.trim()}>
  <EventMedia
    mode={logo ? 'logo' : 'tile'}
    src={logo}
    alt={logo ? `${organiser.name} logo` : ''}
    tile={organiser.category || organiser.name}
    quiet={false}
    size="card"
    frameClass="rounded-lg"
    icon={categoryIcon(organiser.category)}
  />
  <div class="min-w-0">
    {organiser.category && <p class="org-card__category text-sm font-semibold text-moss">{organiser.category}</p>}
    <p class="org-card__title font-serif text-xl font-semibold leading-tight line-clamp-2">{organiser.name}</p>
    {type && <p class="text-sm text-moss">{type}</p>}
    {tagline && <p class="org-card__tagline mt-1 line-clamp-2 text-sm text-moss">{tagline}</p>}
    {organiser.area && <p class="text-sm text-moss">{organiser.area}</p>}
    {alcohol && <p class="text-sm">Alcohol served</p>}
  </div>
</a>

<style>
  .org-card {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    gap: 0.75rem;
    align-items: start;
    padding: 0.85rem 0;
    border-top: 1px solid var(--color-line);
    color: inherit;
    text-decoration: none;
  }
  .org-card:hover .org-card__title,
  .org-card:focus-visible .org-card__title {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .org-card:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }
  @media (max-width: 639px) {
    .org-card {
      grid-template-columns: 5.5rem minmax(0, 1fr);
      gap: 0.65rem;
      align-items: center;
    }
    .org-card__category { display: none; }
    .org-card__title { font-size: 1.05rem; }
  }
</style>
