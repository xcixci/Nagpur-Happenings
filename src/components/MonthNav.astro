---
interface Props {
  prev: { href: string; label: string } | null;
  next: { href: string; label: string } | null;
  kind?: 'month' | 'day' | 'week';
}

const { prev, next, kind = 'month' } = Astro.props;
const word = kind === 'day' ? 'day' : kind === 'week' ? 'week' : 'month';
const group = kind === 'day' ? 'Days' : kind === 'week' ? 'Weeks' : 'Months';
---

<nav class="month-nav" aria-label={group}>
  <a data-prev href={prev?.href} hidden={!prev} aria-label={prev ? `Previous ${word}, ${prev.label}` : undefined}>
    <span aria-hidden="true">←</span>
  </a>
  <span class="month-nav__off" data-prev-off hidden={!!prev} aria-hidden="true">←</span>
  <a data-next href={next?.href} hidden={!next} aria-label={next ? `Next ${word}, ${next.label}` : undefined}>
    <span aria-hidden="true">→</span>
  </a>
  <span class="month-nav__off" data-next-off hidden={!!next} aria-hidden="true">→</span>
</nav>
