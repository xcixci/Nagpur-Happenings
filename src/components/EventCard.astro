---
import EventMedia from './EventMedia.astro';
import { categoryIcon } from '../lib/category-icons';
import { organiserProfile, venueProfile } from '../lib/directory';
import { cardModel, hasEnded, imageUrl, isQuiet, shortDate, timeRange } from '../lib/format';
import { withLocalLogos } from '../lib/logos';
import type { EventRecord, OrganiserRecord, VenueRecord } from '../lib/sheet-map';

interface Props {
  event: EventRecord;
  organisers: OrganiserRecord[];
  venues: VenueRecord[];
  cityName: string;
  domain: string;
  timeZone: string;
  showDate?: boolean;
}

const { event, cityName, domain, timeZone, showDate = true } = Astro.props;
const organisers = withLocalLogos(Astro.props.organisers);
const { venues } = Astro.props;
const model = cardModel(event, organisers, cityName, domain, timeZone);
const cancelled = event.status === 'cancelled';
const quiet = isQuiet(event);
const ended = hasEnded(event, timeZone);
const mode = model.imageKind === 'poster' ? 'poster' : model.imageKind === 'logo' ? 'logo' : 'tile';
const listed = event.organiser_id ? organisers.find((item) => item.id === event.organiser_id) : undefined;
const logo = listed?.logo_url ? imageUrl(listed.logo_url) : '';
const profile = organiserProfile(organisers, event.organiser_id);
const venue = venueProfile(venues, event.venue_id);
const dateLabel = shortDate(event.date, timeZone);
const timeLabel = timeRange(event.start_time, event.end_time);
const icon = quiet ? '' : categoryIcon(event.category);
const href = `/events/${event.slug}/`;
---

<article
  class="event-card"
  data-event
  data-card-id={event.id}
  data-date={event.date}
  data-start={event.start_time}
  data-end={event.end_time}
  data-category={event.category}
  data-price={event.price_type}
  data-status={event.status}
>
  <a class="event-card__media" href={href} tabindex="-1" aria-hidden="true">
    <EventMedia
      mode={mode}
      src={model.image}
      alt={mode === 'poster' ? `Poster for ${event.title}` : mode === 'logo' ? `${event.organiser_name || 'Organiser'} logo` : ''}
      logo={mode === 'poster' ? logo : ''}
      logoAlt={`${event.organiser_name || 'Organiser'} logo`}
      tile={model.tile}
      quiet={quiet}
      size="card"
      frameClass="rounded-lg"
      icon={icon}
    />
  </a>
  <div class="min-w-0">
    {event.category && <p class="event-card__category text-sm font-semibold text-moss">{event.category}</p>}
    {cancelled && <p class="text-sm font-medium">Cancelled</p>}
    <p class="text-sm text-moss" data-ended hidden={!ended}>Ended</p>
    {event.featured && !cancelled && !quiet && <p class="event-card__featured text-sm font-medium">Featured</p>}
    <a class:list={['event-card__title font-serif text-xl font-semibold leading-tight line-clamp-2', cancelled && 'text-moss line-through decoration-2']} href={href}>
      {event.title}
    </a>
    {((showDate && dateLabel) || timeLabel) && (
      <p class="event-card__when mt-1 text-sm">
        {showDate && dateLabel && <span class="event-card__date">{dateLabel}</span>}
        {showDate && dateLabel && timeLabel && <span class="event-card__sep"> · </span>}
        {timeLabel && <span class="event-card__time">{timeLabel}</span>}
      </p>
    )}
    {(event.venue_name || event.area) && (
      <p class="text-sm text-moss">
        {event.venue_name && (venue ? <a href={`/venues/${venue.slug}/`}>{event.venue_name}</a> : event.venue_name)}{event.venue_name && event.area ? ', ' : ''}{event.area}
      </p>
    )}
    {model.by && (
      <p class="text-sm text-moss">
        {profile ? <a href={`/organisers/${profile.slug}/`}>{model.by}</a> : model.by}
      </p>
    )}
    {model.badge && <p class="event-card__meta text-sm">{model.badge}</p>}
    {event.description.trim() && <p class="event-card__desc mt-1 line-clamp-2 text-sm text-moss">{event.description.trim()}</p>}
  </div>
</article>

<style>
  .event-card {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    gap: 0.75rem;
    align-items: start;
    padding: 0.85rem 0;
    border-top: 1px solid var(--color-line);
    color: inherit;
  }
  .event-card__media {
    display: block;
  }
  .event-card__title {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .event-card__title:hover,
  .event-card__title:focus-visible {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .event-card__title:focus-visible,
  .event-card p a:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }
  .event-card p a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  @media (max-width: 639px) {
    .event-card {
      grid-template-columns: 5.5rem minmax(0, 1fr);
      gap: 0.65rem;
      align-items: center;
    }
    .event-card__category,
    .event-card__featured,
    .event-card__date,
    .event-card__sep,
    .event-card__desc {
      display: none;
    }
    .event-card__title { font-size: 1.05rem; }
  }
</style>
