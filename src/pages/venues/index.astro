---
import Page from '../../layouts/Page.astro';
import { city } from '../../lib/city';
import { loadSnapshot } from '../../lib/snapshot';

const snap = loadSnapshot();
const venues = [...snap.venues].sort((a, b) => a.name.localeCompare(b.name));
const origin = Astro.site?.origin ?? `https://${city.domain}`;
const pageUrl = new URL('/venues/', origin).href;
const title = `Venues · ${city.name} Happenings`;
const description = `Places that host events in ${city.name}.`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: `${city.name} Happenings`, item: new URL('/', origin).href },
    { '@type': 'ListItem', position: 2, name: 'Venues', item: pageUrl },
  ],
};
---

<Page title={title} description={description} canonical={pageUrl} jsonLd={[jsonLd]}>
  <main class="mx-auto w-full max-w-5xl flex-1 px-4 py-6">
    <h1 class="font-serif text-3xl font-semibold leading-tight sm:text-4xl">Venues</h1>
    {venues.length === 0 ? (
      <p class="quiet-line">No venues listed yet.</p>
    ) : (
      <ul class="mt-4">
        {venues.map((venue) => (
          <li class="border-t border-line">
            <a class="group block py-3 text-ink no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink" href={`/venues/${venue.slug}/`}>
              <span class="block font-serif text-xl font-semibold leading-tight group-hover:underline">{venue.name}</span>
              {venue.area && <span class="mt-1 block text-sm text-moss">{venue.area}</span>}
              {venue.address && <span class="block text-sm text-moss">{venue.address}</span>}
            </a>
          </li>
        ))}
      </ul>
    )}
  </main>
</Page>
