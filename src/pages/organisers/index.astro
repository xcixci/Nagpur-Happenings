---
import FilterBar from '../../components/FilterBar.astro';
import OrganiserCard from '../../components/OrganiserCard.astro';
import Page from '../../layouts/Page.astro';
import { usedCategories } from '../../lib/calendar';
import { city } from '../../lib/city';
import { verifiedOrganisers } from '../../lib/directory';
import { loadSnapshot } from '../../lib/snapshot';

const snap = loadSnapshot();
const organisers = verifiedOrganisers(snap.organisers);
const categories = usedCategories(snap.categories, organisers);
const origin = Astro.site?.origin ?? `https://${city.domain}`;
const pageUrl = new URL('/organisers/', origin).href;
const title = `Organisers · ${city.name} Happenings`;
const description = `Communities, clubs and groups in ${city.name}.`;
const welcome = `Every listing on ${city.name} Happenings is expected to welcome everyone.`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: `${city.name} Happenings`, item: new URL('/', origin).href },
    { '@type': 'ListItem', position: 2, name: 'Organisers', item: pageUrl },
  ],
};
---

<Page title={title} description={description} canonical={pageUrl} jsonLd={[jsonLd]}>
  <main class="mx-auto w-full max-w-5xl flex-1 px-4 py-6" data-calendar data-timezone={city.timezone}>
    <h1 class="font-serif text-3xl font-semibold leading-tight sm:text-4xl">Organisers</h1>
    <p class="mt-3 max-w-prose">{welcome}</p>
    {city.organiser_form_url && (
      <p class="mt-4">
        <a class="inline-flex min-h-11 items-center rounded-lg bg-ink px-4 font-medium text-on-ink no-underline hover:bg-ink-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink" href="/register/">
          List your community
        </a>
      </p>
    )}
    {organisers.length > 0 && (
      <div data-view data-empty-scope="here">
        {categories.length > 0 && <FilterBar categories={categories} showFree={false} noun="organiser" />}
        <div>
          {organisers.map((organiser) => <OrganiserCard organiser={organiser} />)}
        </div>
        <p class="quiet-line" data-view-empty hidden>Nothing listed here yet.</p>
      </div>
    )}
  </main>
</Page>

<script>
  import { startCalendar } from '../../scripts/calendar';
  startCalendar();
</script>
