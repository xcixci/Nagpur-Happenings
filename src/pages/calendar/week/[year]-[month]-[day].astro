---
import AgendaDay from '../../../components/AgendaDay.astro';
import FilterBar from '../../../components/FilterBar.astro';
import MonthNav from '../../../components/MonthNav.astro';
import Page from '../../../layouts/Page.astro';
import { city } from '../../../lib/city';
import {
  addDays,
  calendarEvents,
  datesFrom,
  dayNames,
  eventsOn,
  filterCategories,
  monthName,
  monthPath,
  visibleMonths,
  visibleWeeks,
  weekMonths,
  weekPath,
  weekRangeLabel,
} from '../../../lib/calendar';
import { cityToday, parseIso } from '../../../lib/format';
import { loadSnapshot } from '../../../lib/snapshot';

export function getStaticPaths() {
  const snap = loadSnapshot();
  const today = cityToday(city.timezone);
  return visibleWeeks(snap.events, today).map((date) => {
    const [year, month, day] = date.split('-');
    if (!year || !month || !day) throw new Error(`Bad week ${date}`);
    return { params: { year, month, day }, props: { date } };
  });
}

interface Props {
  date: string;
}

const { date } = Astro.props;
if (!parseIso(date)) throw new Error(`Bad week ${date}`);
const snap = loadSnapshot();
const today = cityToday(city.timezone);
const listed = calendarEvents(snap.events);
const weeks = visibleWeeks(listed, today);
const index = weeks.indexOf(date);
const prev = index > 0 ? weeks[index - 1] ?? null : null;
const next = index >= 0 ? weeks[index + 1] ?? null : null;
const dates = datesFrom(date, addDays(date, 6));
const range = weekRangeLabel(date);
const heading = `Events in ${city.name}, ${range}`;
const months = weekMonths(date, visibleMonths(listed, today));
const step = (monday: string | null) => (monday ? { href: weekPath(monday), label: weekRangeLabel(monday) } : null);
const origin = Astro.site?.origin ?? `https://${city.domain}`;
const pageUrl = new URL(weekPath(date), origin).href;
const crumbMonth = months[0];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: `${city.name} Happenings`, item: new URL('/', origin).href },
    ...(crumbMonth
      ? [{
          '@type': 'ListItem',
          position: 2,
          name: `${monthName(crumbMonth)} ${crumbMonth.year}`,
          item: new URL(monthPath(crumbMonth), origin).href,
        }]
      : []),
    { '@type': 'ListItem', position: crumbMonth ? 3 : 2, name: range, item: pageUrl },
  ],
};
---

<Page title={heading} description={heading} jsonLd={[jsonLd]}>
  <main
    class="calendar mx-auto w-full max-w-5xl flex-1 px-4 py-6"
    data-calendar
    data-timezone={city.timezone}
    data-built-today={today}
  >
    <div class="cal-toolbar">
      <div class="cal-heading">
        <h1 class="font-serif text-3xl font-semibold leading-tight sm:text-4xl">{heading}</h1>
        {months.length > 0 && (
          <p class="scope-links">
            {months.map((ym) => <a href={monthPath(ym)}>All of {monthName(ym)}</a>)}
          </p>
        )}
      </div>
      <MonthNav kind="week" prev={step(prev)} next={step(next)} />
    </div>
    <FilterBar categories={filterCategories(snap.categories, listed)} />
    <ol class="agenda-days">
      {dates.map((iso) => (
        <AgendaDay
          date={iso}
          names={dayNames(snap.days, iso)}
          events={eventsOn(listed, iso)}
          today={today}
          kind="week"
          organisers={snap.organisers}
          cityName={city.name}
          domain={city.domain}
          timeZone={city.timezone}
        />
      ))}
    </ol>
  </main>
</Page>

<script>
  import { startCalendar } from '../../../scripts/calendar';
  startCalendar();
</script>
