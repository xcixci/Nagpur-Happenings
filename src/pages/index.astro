---
import CalendarHome from '../components/CalendarHome.astro';
import Page from '../layouts/Page.astro';
import { city } from '../lib/city';
import { loadSnapshot } from '../lib/snapshot';

const snap = loadSnapshot();
const title = `${city.name} Happenings`;
const description = `A calendar of book clubs, workshops, meetups and community events in ${city.name}.`;
---

<Page title={title} description={description}>
  <main class="mx-auto w-full max-w-5xl flex-1 px-4 py-6">
    <CalendarHome
      events={snap.events}
      days={snap.days}
      organisers={snap.organisers}
      venues={snap.venues}
      categories={snap.categories}
    />
  </main>
</Page>
