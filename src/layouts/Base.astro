---
import '../styles/global.css';
import { city } from '../lib/city';
import icon from '../../brand/logo/nh-icon.svg?url';

interface Props {
  title: string;
  socialTitle?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  canonical?: string;
  ogUrl?: string;
  noindex?: boolean;
  jsonLd?: unknown[];
}

const {
  title,
  socialTitle = title,
  description = `Events in ${city.name}.`,
  image,
  imageAlt = socialTitle,
  noindex = false,
  jsonLd = [],
} = Astro.props;
const canonical = Astro.props.canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const ogUrl = Astro.props.ogUrl ?? canonical;
const json = (data: unknown) => JSON.stringify(data).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <slot name="head" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0E451C" />
    <link rel="icon" href={icon} type="image/svg+xml" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${city.name} Happenings`} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={description} />
    {image && (
      <>
        <meta property="og:image" content={image} />
        <meta property="og:image:type" content="image/jpeg" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={imageAlt} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:image" content={image} />
        <meta name="twitter:image:alt" content={imageAlt} />
      </>
    )}
    {!image && <meta name="twitter:card" content="summary" />}
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={description} />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={json(data)} />)}
    {city.umami_website_id && (
      <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id={city.umami_website_id}></script>
    )}
  </head>
  <body class="flex min-h-screen flex-col">
    <slot />
  </body>
</html>
